# AETHER X Backend Environment Configuration
# Copy this file to .env and configure your secrets

# Google Gemini API
# Get your key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Supported models: gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI API (Optional secondary / fallback provider)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# AI Provider Configuration: auto | gemini | openai
AI_PROVIDER=auto

# Security & Authentication
AETHER_AUTH_SECRET=YOUR_RANDOM_AETHER_AUTH_SECRET_KEY
RATE_LIMIT_PER_MINUTE=60

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://aether:aether_password@localhost:5432/aether_x

# Server Host and Port
HOST=0.0.0.0
PORT=8000
DEBUG=false
