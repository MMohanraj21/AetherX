<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVoiceModeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zara_bg_oled">

    <!-- Top Navigation Bar -->
    <ImageButton
        android:id="@+id/btnVoiceClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_zara_icon_ripple"
        android:src="@drawable/ic_close"
        app:tint="@color/zara_text_primary"
        android:contentDescription="Minimize to Island"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutVoiceHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoiceClose"
        app:layout_constraintBottom_toBottomOf="@id/btnVoiceClose">

        <TextView
            android:id="@+id/tvVoiceModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZARA LIVE"
            android:textColor="@color/zara_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gemini 2.5 Flash • 240ms"
            android:textColor="@color/zara_gemini_blue"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Strict Voice Lock Selector Pill -->
    <LinearLayout
        android:id="@+id/btnVoiceSelectorLock"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_zara_pill_chip"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnVoiceClose"
        app:layout_constraintBottom_toBottomOf="@id/btnVoiceClose">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_settings_lock"
            app:tint="@color/zara_accent_purple"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvSelectedVoiceLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aoede (F)"
            android:textColor="@color/zara_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Center Living Waveform / Audio Visualizer Stage -->
    <FrameLayout
        android:id="@+id/stageVisualizerContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <View
            android:id="@+id/viewAmbientHalo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_zara_aura_glow" />

        <ImageView
            android:id="@+id/ivWaveformCenter"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_waveform_live"
            app:tint="@color/zara_accent_purple" />
    </FrameLayout>

    <!-- State Indicator Pill (LISTENING / THINKING / SPEAKING) -->
    <LinearLayout
        android:id="@+id/pillStateIndicator"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_zara_pill_chip"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/stageVisualizerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/viewStateDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_zara_badge_success"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvVoiceStateIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LISTENING (CONTINUOUS)"
            android:textColor="@color/zara_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Live Subtitles & Transcript Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLiveTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/zara_card_elevated"
        app:strokeColor="@color/zara_card_border"
        app:strokeWidth="1dp"
        app:cardCornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/pillStateIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLiveTranscriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="I am listening, Mohanraj. Go ahead and speak..."
            android:textColor="@color/zara_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="sans-serif" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls Dock -->
    <LinearLayout
        android:id="@+id/layoutVoiceControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mic Mute Toggle -->
        <FrameLayout
            android:id="@+id/btnVoiceMicToggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_zara_composer_dock"
            android:layout_marginEnd="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivVoiceMicStatus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic_jarvis"
                app:tint="@color/zara_text_primary" />
        </FrameLayout>

        <!-- End Session Button -->
        <FrameLayout
            android:id="@+id/btnVoiceEndSession"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_zara_live_voice_glow"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Interrupt / Stop Speaking Button -->
        <FrameLayout
            android:id="@+id/btnVoiceInterrupt"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_zara_composer_dock"
            android:layout_marginStart="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                app:tint="@color/zara_text_primary" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
